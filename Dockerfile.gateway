FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod ./
COPY cmd ./cmd
COPY internal ./internal
RUN test -z "$(gofmt -l .)" && go test ./... && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /marketpulse ./cmd/gateway

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /marketpulse /marketpulse
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/marketpulse"]
